@base = http://localhost:8000

### Сервис жив?
GET {{base}}/health

### Создать плейлист
POST {{base}}/api/playlists
Content-Type: application/json

{
    "name": "Rock Music",
    "author": "Denis"
}

### Список плейлистов
GET {{base}}/api/playlists

### Список с пагинацией и фильтром по автору
GET {{base}}/api/playlists?limit=5&offset=0&author=Denis

### Поиск по названию (без учёта регистра)
GET {{base}}/api/playlists?q=rock

### Получить один плейлист
GET {{base}}/api/playlists/1

### Изменить плейлист
PATCH {{base}}/api/playlists/1
Content-Type: application/json

{
    "name": "Classic Rock"
}

### Добавить трек
POST {{base}}/api/playlists/1/tracks
Content-Type: application/json

{
    "title": "Bohemian Rhapsody",
    "artist": "Queen",
    "duration": 354
}

### Тот же трек второй раз, должен быть 409
POST {{base}}/api/playlists/1/tracks
Content-Type: application/json

{
    "title": "Bohemian Rhapsody",
    "artist": "Queen",
    "duration": 354
}

### Добавить второй трек
POST {{base}}/api/playlists/1/tracks
Content-Type: application/json

{
    "title": "Radio Ga Ga",
    "artist": "Queenie",
    "duration": 343
}

### Список треков плейлиста
GET {{base}}/api/playlists/1/tracks

### Статистика одного плейлиста
GET {{base}}/api/playlists/1/stats

### Статистика по всем плейлистам
GET {{base}}/api/playlists/stats

### Удалить трек
DELETE {{base}}/api/playlists/1/tracks/2

### Сломанный JSON, должен быть 400
POST {{base}}/api/playlists
Content-Type: application/json

{ "name":

### Пустое обязательное поле, должен быть 400
POST {{base}}/api/playlists
Content-Type: application/json

{ "name": "", "author": "Denis" }

### Удалить плейлист
DELETE {{base}}/api/playlists/1

### После удаления должен быть 404
GET {{base}}/api/playlists/1
