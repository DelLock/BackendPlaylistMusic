# Скопировать в .env и при необходимости поменять.
DATABASE_URL=sqlite:///./app.db

# Секрет для подписи JWT. Должен быть длинным и случайным, например: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string
# Сколько минут живёт токен
JWT_EXPIRE_MINUTES=30

# Администратор, которого создаёт `python seed.py`. Через регистрацию админом стать нельзя.
# Это значения для локальной разработки и проверки backcheck, в реальной работе их нужно заменить.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-test-pass
